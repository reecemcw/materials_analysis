{
  "name": "materials_analysis_app",
  "version": "1.2.0",
  "description": "NodeJS App which (ethically) scrapes materials analysis articles, stores article data, generates metadata, and allows the user to query the database with natural language effectively with RAG. ",
  "main": "index.js",
  "scripts": {
    "ports:kill":  "kill -15 $(lsof -ti:3000,3001,3002,3003,3004,3005)",
    "install:all": "npm install && npm run install:services",
    "install:services": "npm install --workspaces",

    "dev": "npm run dev:all",
    "dev:all": "concurrently \"npm run dev:discovery\" \"npm run dev:scraper\" \"npm run dev:frontend\" \"npm run dev:labeller\" \"npm run dev:kg\" \"npm run dev:scheduler\"",
    "dev:scraper": "cd services/scraper && SERVICE_NAME=scraper nodemon src/server.js",
    "dev:frontend": "cd services/frontend && SERVICE_NAME=frontend nodemon src/server.js",
    "dev:labeller": "cd services/labeller && SERVICE_NAME=labeller nodemon src/server.js",
    "dev:kg": "cd services/knowledge-graph && SERVICE_NAME=knowledge-graph nodemon src/server.js",
    "dev:scheduler": "cd services/scheduler && SERVICE_NAME=scheduler nodemon src/server.js",
    "dev:discovery": "cd services/discovery && SERVICE_NAME=discovery nodemon src/server.js",

    "test-pipeline": "cd tests/pipeline && node test-pipeline.mjs",
    "test:discovery": "cd tests/pipeline && node test-discovery.mjs",
    "test:discovery:dry": "node services/discovery/test-discovery.mjs --dry-run",
    "test:kg": "node --test services/knowledge-graph/tests/graph.test.mjs"
  },
  "workspaces": [
    "services/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reecemcw/materials_analysis.git"
  },
  "keywords": [
    "materials",
    "analysis",
    "rag",
    "ai",
    "llm",
    "metatagging",
    "scrape"
  ],
  "author": "Reece McWalter",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/reecemcw/materials_analysis/issues"
  },
  "homepage": "https://github.com/reecemcw/materials_analysis#readme",
  "type": "module",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "mongodb": "^7.1.0",
    "mongoose": "^9.2.1",
    "node-cron": "^4.2.1",
    "nodemon": "^3.0.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
